# pdfjs-dist richiede Node >=22.13 (usa ArrayBuffer.transferToFixedLength).
# Su Node 20 npm si limiterebbe a un avviso e l'app partirebbe lo stesso, ma il
# rendering dei PDF produrrebbe pagine BIANCHE senza nessun errore visibile
# (l'errore viene ingoiato da pdfjs). Meglio fallire subito e a voce alta.
engine-strict=true
