# Porta su cui ascolta il backend
PORT=3000

# Origine consentita per le richieste CORS (URL dell'app / * in sviluppo)
ALLOWED_ORIGIN=*

# Se true (default), l'analisi usa dati di esempio invece di chiamare Azure.
# Utile per sviluppare/testare l'app prima di avere una chiave Azure valida.
# Impostare a "false" quando le due variabili sotto sono valorizzate.
MOCK_OCR=true

# Azure AI Document Intelligence (ex Form Recognizer) - modello "prebuilt-layout"
# Valorizzare quando la chiave sara' disponibile e mettere MOCK_OCR=false
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
