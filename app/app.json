{
  "expo": {
    "name": "Turni",
    "slug": "turni-app",
    "scheme": "turniapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turniapp.mobile"
    },
    "android": {
      "package": "com.turniapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F172A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app usa le foto per leggere la griglia dei turni che carichi.",
          "cameraPermission": "L'app usa la fotocamera per fotografare la griglia dei turni."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "apiBaseUrl": "https://turni-app-5oxl.onrender.com",
      "eas": {
        "projectId": "ab7faa7d-efdb-4ecc-b6a5-95c843549fa9"
      }
    }
  }
}
